# shellcheck shell=bash
# shellcheck disable=SC2034  # Vars consumed by Kamal externally.
# Kamal parses this with its own dotenv reader (NOT bash): only literal values
# and $(...) command substitution. Shared by deploy.yml and deploy.api.yml.
INFRA=../../infra
APP=../../infra/secrets/apps/clips.enc.yaml

KAMAL_REGISTRY_PASSWORD=$(sops -d --extract '["docker_registry_password"]' "$INFRA/secrets/shared.enc.yaml")

# Prisma (frontend) wants postgres://, SQLAlchemy (backend) wants postgresql+asyncpg://
DATABASE_URL=$(sops -d --extract '["db_uri"]' "$APP")
BACKEND_DATABASE_URL=$(sops -d --extract '["db_uri"]' "$APP" | sed 's@^postgres://@postgresql+asyncpg://@')

BETTER_AUTH_SECRET=$(sops -d --extract '["better_auth_secret"]' "$APP")
BACKEND_AUTH_SECRET=$(sops -d --extract '["backend_auth_secret"]' "$APP")
APP_SETTINGS_ENCRYPTION_KEY=$(sops -d --extract '["app_settings_encryption_key"]' "$APP")
REDIS_PASSWORD=$(sops -d --extract '["redis_password"]' "$APP")
ASSEMBLY_AI_API_KEY=$(sops -d --extract '["assembly_ai_api_key"]' "$APP")
ANTHROPIC_API_KEY=$(sops -d --extract '["anthropic_api_key"]' "$APP")
MEDIA_S3_ENDPOINT=$(sops -d --extract '["r2_endpoint"]' "$APP")
MEDIA_S3_ACCESS_KEY_ID=$(sops -d --extract '["r2_access_key_id"]' "$APP")
MEDIA_S3_SECRET_ACCESS_KEY=$(sops -d --extract '["r2_secret_access_key"]' "$APP")
